          "rules": [
            {
              "id": "CODE-QV-ASYMMETRIC",
              "name": "CodeQvAsymmetric",
              "shortDescription": {
                "text": "Quantum-vulnerable Ed25519: transaction and message signing (1 file(s))"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "post_quantum",
                  "pq_long_term_risk"
                ],
                "security-severity": "5.0"
              },
              "fullDescription": {
                "text": "1 reference(s) to Ed25519 across 1 file(s), e.g. soroban-env-host/src/builtin_contracts/stellar_asset_contract/metadata.rs:158. Role, judged from paths, function names and nearby code: transaction and message signing. A CRQC derives the private key from a public key that is already known (on chain after the first spend, in reused addresses): funds and approvals controlled by these keys need a migration path. Follow each chain's post-quantum roadmap, avoid public-key reuse, and keep signers ready to add post-quantum signature schemes as chains adopt them. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability. Heuristic pattern match on source text without data-flow analysis. The usage context (security-relevant or not) must be confirmed manually; treat as preliminary."
              },
              "help": {
                "text": "1 reference(s) to Ed25519 across 1 file(s), e.g. soroban-env-host/src/builtin_contracts/stellar_asset_contract/metadata.rs:158. Role, judged from paths, function names and nearby code: transaction and message signing. A CRQC derives the private key from a public key that is already known (on chain after the first spend, in reused addresses): funds and approvals controlled by these keys need a migration path. Follow each chain's post-quantum roadmap, avoid public-key reuse, and keep signers ready to add post-quantum signature schemes as chains adopt them. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability. Heuristic pattern match on source text without data-flow analysis. The usage context (security-relevant or not) must be confirmed manually; treat as preliminary."
              },
              "helpUri": "https://doi.org/10.1137/S0097539795293172"
            },
            {
              "id": "DEP-KNOWN-ADVISORY",
              "name": "DepKnownAdvisory",
              "shortDescription": {
                "text": "serde_with 3.12.0 is affected by GHSA-7gcf-g7xr-8hxj"
              },
