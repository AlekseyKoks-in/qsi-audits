            {
              "id": "DEP-KNOWN-ADVISORY",
              "name": "DepKnownAdvisory",
              "shortDescription": {
                "text": "org.postgresql:postgresql 42.7.11 is affected by GHSA-j92g-9f8w-j867 (CVE-2026-54291)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "dependencies",
                  "known_vulnerable_component"
                ],
                "security-severity": "7.5"
              },
              "fullDescription": {
                "text": "OSV.dev reports GHSA-j92g-9f8w-j867 (CVE-2026-54291) for Maven package org.postgresql:postgresql at version 42.7.11: PostgreSQL JDBC Driver: Silent channel-binding authentication downgrade via unsupported certificate algorithms. The advisory names no affected functions, so reachability was not determined. Upgrade to a fixed version (42.7.12). Advisory data comes from OSV.dev at the recorded time. Reachability is judged from names, not a call graph: the affected functions the advisory lists against the identifiers in the audited product code, a Cargo feature it says is off by default against the audited manifests, the platforms it lists against the declared Rust targets. Indirect calls (traits, macros, other dependencies) are not followed."
              },
              "help": {
                "text": "OSV.dev reports GHSA-j92g-9f8w-j867 (CVE-2026-54291) for Maven package org.postgresql:postgresql at version 42.7.11: PostgreSQL JDBC Driver: Silent channel-binding authentication downgrade via unsupported certificate algorithms. The advisory names no affected functions, so reachability was not determined. Upgrade to a fixed version (42.7.12). Advisory data comes from OSV.dev at the recorded time. Reachability is judged from names, not a call graph: the affected functions the advisory lists against the identifiers in the audited product code, a Cargo feature it says is off by default against the audited manifests, the platforms it lists against the declared Rust targets. Indirect calls (traits, macros, other dependencies) are not followed."
              },
              "helpUri": "https://osv.dev/vulnerability/GHSA-j92g-9f8w-j867"
            },
