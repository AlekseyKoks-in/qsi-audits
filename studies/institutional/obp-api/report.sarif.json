              "helpUri": "https://doi.org/10.1137/S0097539795293172"
            },
            {
              "id": "CERT-QV-KEY",
              "name": "CertQvKey",
              "shortDescription": {
                "text": "Quantum-vulnerable RSA key in certificate (app.example.com)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "post_quantum",
                  "pq_long_term_risk"
                ],
                "security-severity": "3.0"
              },
              "fullDescription": {
                "text": "The certificate app.example.com uses a RSA 2048-bit public key, valid until 2025-11-26. RSA is broken by Shor's algorithm on a CRQC. Track in the PQC inventory; prefer short certificate lifetimes; follow CA/Browser Forum and NIST PQC transition guidance for ML-DSA certificates. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability."
              },
              "help": {
                "text": "The certificate app.example.com uses a RSA 2048-bit public key, valid until 2025-11-26. RSA is broken by Shor's algorithm on a CRQC. Track in the PQC inventory; prefer short certificate lifetimes; follow CA/Browser Forum and NIST PQC transition guidance for ML-DSA certificates. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability."
              },
              "helpUri": "https://doi.org/10.1137/S0097539795293172"
            },
            {
              "id": "CERT-LONG-VALIDITY",
              "name": "CertLongValidity",
              "shortDescription": {
                "text": "Leaf certificate validity of 730 days (app.example.com)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "certificates",
                  "improvement"
                ],
                "security-severity": "3.0"
              },
              "fullDescription": {
                "text": "The end-entity certificate is valid for 730 days. Publicly trusted TLS certificates are limited to 398 days today, and CA/Browser Forum rules are reducing this further. Use shorter validity with automated renewal. Document-based analysis: only the supplied file was examined. Deployed configuration may differ; the result reflects the file content at the recorded SHA-256. Private-PKI certificates may intentionally use other policies."
              },
              "help": {
                "text": "The end-entity certificate is valid for 730 days. Publicly trusted TLS certificates are limited to 398 days today, and CA/Browser Forum rules are reducing this further. Use shorter validity with automated renewal. Document-based analysis: only the supplied file was examined. Deployed configuration may differ; the result reflects the file content at the recorded SHA-256. Private-PKI certificates may intentionally use other policies."
