                  "security",
                  "source_code",
                  "potential_crypto_risk"
                ],
                "security-severity": "5.0"
              },
              "fullDescription": {
                "text": "1 call site(s) of SHA-1 (first at line 50). Replace with SHA-256/SHA-3 (or Argon2/bcrypt for passwords) where security-relevant. Heuristic pattern match on source text without data-flow analysis. The usage context (security-relevant or not) must be confirmed manually; treat as preliminary."
              },
              "help": {
