            {
              "id": "KEY-QV-PUBLIC",
              "name": "KeyQvPublic",
              "shortDescription": {
                "text": "Quantum-vulnerable RSA key (2048-bit) in responsible_disclosure.md"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "post_quantum",
                  "pq_long_term_risk"
                ],
                "security-severity": "3.0"
              },
              "fullDescription": {
                "text": "A RSA 2048-bit public key was found (line 11). Inventory and plan migration to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205), in a hybrid/composite form where the ecosystem supports it.. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability."
              },
              "help": {
                "text": "A RSA 2048-bit public key was found (line 11). Inventory and plan migration to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205), in a hybrid/composite form where the ecosystem supports it.. This is a forward-looking risk that depends on the arrival of a cryptographically relevant quantum computer (CRQC). No such computer is publicly known to exist today; the timeline is uncertain. It is not a present-day exploitable vulnerability."
